<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="server_url" default="http://127.0.0.1:8765/predict"/>
  <arg name="task" default="drive the racing kart around the course"/>

  <include file="$(find-pkg-share act_lerobot_controller)/launch/smolvla_remote.launch.xml">
    <arg name="server_url" value="$(var server_url)"/>
    <arg name="task" value="$(var task)"/>
    <arg name="control_cmd_topic" value="/control/command/control_cmd"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
